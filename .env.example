# === Lokalny PostgreSQL (wymagane) ===
DATABASE_URL=postgresql://ontime_app:dev@127.0.0.1:5432/ontime_dev
DATABASE_MIGRATE_URL=postgresql://ontime_migrator:dev@127.0.0.1:5432/ontime_dev
DATABASE_POOL_MAX=20
SESSION_SECRET=dev-session-secret-min-32-characters-long
SESSION_TTL_DAYS=7
STORAGE_ROOT=./.storage-dev
STORAGE_SIGNING_SECRET=dev-storage-signing-secret-32chars

# Amazon SES SMTP (eu-central-1) — wymagane do wysyłki e-maili
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_DOMAIN=ontime.mikran.pl
EMAIL_FROM_LOCAL=OnTime
EMAIL_FROM=OnTime <tomek@ontime.mikran.pl>
CRON_SECRET=change-me-in-production
SETUP_TOKEN=
PASSWORD_RESET_OTP_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=http://ontime.mikran.pl:3000

# --- Subiekt (opcjonalnie) ---
# SUBIEKT_API_BASE_URL=http://192.168.0.140:5080/api/v1
# ZK z maila (/zk/z-maila) — wyszukiwanie klientów/towarów i create ZK. Tylko kopia testowa :5082 (live zablokowany w kodzie).
# SUBIEKT_API_ZK_BASE_URL=http://192.168.0.140:5082/api/v1

# --- Google AI (Gemini) — Vision OCR ---
GOOGLE_AI_API_KEY=

# Cutover (tylko migracja A→B):
# SUPABASE_DB_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Gmail — wysyłka zamówień ZD z firmowej skrzynki użytkownika (OAuth „Internal”, zakres gmail.send).
# Przekierowanie w Google Cloud: ${NEXT_PUBLIC_APP_URL}/api/google/callback (HTTPS).
# Puste = funkcja ukryta. Klucz tokenów: openssl rand -base64 32 (zmiana klucza = wszyscy łączą ponownie).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_KEY=

# Helpdesk sklepu mikran.pl (Serwis → zgłoszenia do przyjęcia). OAuth client_credentials, scope helpdesk:read.
# Puste klucze: na produkcji sekcja wyłączona, lokalnie dane testowe (zgłoszenia „TEST”).
MIKRAN_API_CLIENT_ID=
MIKRAN_API_CLIENT_SECRET=
# MIKRAN_API_BASE_URL=https://mikran.pl
# employee_id serwisanta w helpdesku („Obsługuje”, filter_users w panelu sklepu) — tylko jego zgłoszenia.
MIKRAN_HELPDESK_EMPLOYEE_ID=28
# status_id otwartych: 1 = Nowe zgłoszenie, 4 = Przyjęte do realizacji (5 = Zakończone); puste = 90 dni bez zakończonych.
MIKRAN_HELPDESK_STATUS_IDS=1,4
