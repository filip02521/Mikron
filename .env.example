NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Amazon SES SMTP (eu-central-1) — wymagane do wysyłki e-maili
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# STARTTLS na 587 → false; SSL na 465 → true
SMTP_SECURE=false
# Domena zweryfikowana w SES (DNS: DKIM + SPF/DMARC)
EMAIL_DOMAIN=ontime.mikran.pl
# Nadawca — Nazwa <adres@domena>; bez EMAIL_FROM: OnTime@EMAIL_DOMAIN
EMAIL_FROM_LOCAL=OnTime
EMAIL_FROM=OnTime <tomek@ontime.mikran.pl>
# Opcjonalnie: testy bez wysyłki do handlowców (wszystko na ten adres)
# EMAIL_OVERRIDE_TO=tylko-na-czas-testow@example.com
# RESEND_API_KEY — usunięte; nie ustawiać

# Link do OnTime Raporty (Centrum maili Ivoclar) — tylko server-side (nie NEXT_PUBLIC_*)
# RAPORTY_RUNNER_URL=http://raporty.ontime.mikran
# Opcjonalnie osobny secret do GET /api/ivoclar/status (domyślnie = CRON_SECRET OT)
# RAPORTY_CRON_SECRET=same-as-raporty-cron-secret
CRON_SECRET=change-me-in-production
# Jednorazowy token bootstrapu (/setup?token=...) — wymagany na produkcji.
# Wygeneruj: openssl rand -hex 16
SETUP_TOKEN=
# Losowy sekret do hashowania kodów OTP resetu hasła (min. 32 znaki). Produkcja: wymagany.
# Wygeneruj: openssl rand -hex 32
PASSWORD_RESET_OTP_SECRET=
# Weryfikacja migracji 068–070 (pg_policy) — hasło z Supabase → Settings → Database
# SUPABASE_DB_PASSWORD=
# Opcjonalnie pełny connection string:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produkcja (serwer LAN Mikran) — APP_URL bez przebudowy po zmianie hosta:
# APP_URL=http://ontime.mikran.pl:3000
# NEXT_PUBLIC_APP_URL=http://ontime.mikran.pl:3000
# APP_SERVER_HOST=192.168.0.140
# APP_PORT=3000
# LAN_DEV_HOST=ontime.mikran.pl
# SERVER_ACTION_ALLOWED_ORIGINS=ontime.mikran.pl,ontime.mikran.pl:3000,192.168.0.140,192.168.0.140:3000
# Test z telefonu w Wi‑Fi (dev):
# NEXT_PUBLIC_APP_URL=http://192.168.x.x:3000
# LAN_DEV_HOST=192.168.x.x
# Gdy dev otwierasz z innego hosta/IP i Server Actions zwracają „unexpected response”:
# SERVER_ACTION_ALLOWED_ORIGINS=192.168.1.42,192.168.1.42:3000
# Dev: przycisk „Wymuś odświeżenie terminów ZD” na /moje (tylko testy)
# NEXT_PUBLIC_ZD_ETA_DEV_REFRESH=true

# Pierwsza konfiguracja serwera (Linux / LAN):
#   npm run server-setup
#   npm run server-setup -- --from-env .env.work --systemd --cron

# --- Subiekt (opcjonalnie, tylko w LAN) — patrz docs/integrations/subiekt.md ---
# Wzór na pracę: .env.subiekt.work.example
# SUBIEKT_API_BASE_URL=http://192.168.0.140:5080/api/v1
# SUBIEKT_API_AUTH_MODE=none
# Kreator ZD (/zakupy/szacunek) — :5080 live (aktualna baza) lub :5082 test:
# SUBIEKT_API_ORDERS_BASE_URL=http://192.168.0.140:5080/api/v1
# SUBIEKT_API_ORDERS_TIMEOUT_MS=60000
# SUBIEKT_API_KEY=
# SUBIEKT_API_USER=
# SUBIEKT_API_PASSWORD=
# SUBIEKT_API_KEY_HEADER=X-Api-Key
# SUBIEKT_API_HEALTH_PATH=/health
# SUBIEKT_API_TIMEOUT_MS=15000

# --- Google AI (Gemini) — Vision OCR dla list zębów ---
# Klucz API z https://aistudio.google.com/apikey
# Darmowy tier ma limity dzienne — przy wyczerpaniu włącz Billing w Google AI / Google Cloud.
GOOGLE_AI_API_KEY=
# Opcjonalnie: wymuś model (domyślnie: 2.5-flash → 2.0-flash → 2.0-flash-lite)
# GOOGLE_AI_GEMINI_MODEL=gemini-2.0-flash
