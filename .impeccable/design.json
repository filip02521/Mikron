      "html": "<table class=\"ds-table\"><thead><tr><th>Numer</th><th>Towar</th><th>Kartotekowa netto</th></tr></thead><tbody><tr><td class=\"ds-code\">531664</td><td>Ips classic v neutral 20g</td><td class=\"ds-num\"><s>42,37</s> <b>43,07</b> <small>+1,7%</small></td></tr><tr><td class=\"ds-code\">531745</td><td>ProBase Hot Polymer 500g Pink V</td><td class=\"ds-num\"><s>110,24</s> <b>112,64</b> <small>+2,2%</small></td></tr></tbody></table>",
      "css": ".ds-table{width:100%;border-collapse:collapse;font-family:Geist, ui-sans-serif, system-ui, sans-serif;font-size:.875rem;line-height:1.45;background:#fff}.ds-table th{padding:.875rem 1.25rem;background:#f6f7f9;border-bottom:1px solid #e1e4e9;text-align:left;font-size:.75rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#626a76;white-space:nowrap}.ds-table td{padding:1rem 1.25rem;border-bottom:1px solid #eef0f3;color:#4a515c}.ds-table tbody tr:hover td{background:#f6f7f9}.ds-table tbody tr:hover td:first-child{box-shadow:inset 3px 0 0 0 #0f7380}.ds-code{font-family:\"Geist Mono\",ui-monospace,monospace;font-size:.75rem}.ds-num{font-variant-numeric:tabular-nums;white-space:nowrap}.ds-num s{color:#626a76;text-decoration-color:#c9ced6}.ds-num b{color:#151920;font-weight:600}.ds-num small{color:#626a76;font-size:.75rem}"
