{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.ts|*.tsx) cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install eslint --fix \"$f\" ;; esac; exit 0",
            "timeout": 60,
            "statusMessage": "eslint --fix"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.sh",
            "timeout": 900,
            "statusMessage": "Bramka push: authz + pre-deploy"
          }
        ]
      }
    ]
  }
}
